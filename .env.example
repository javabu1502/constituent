# =============================================================================
# My Democracy — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# Required — the app will not start without these
# ---------------------------------------------------------------------------

# Anthropic Claude API key for AI message generation and chat
ANTHROPIC_API_KEY=

# Congress.gov API key — https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Google Maps API key for address autocomplete and geocoding
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Optional — features degrade gracefully without these
# ---------------------------------------------------------------------------

# Claude model override (defaults to claude-sonnet-4-20250514)
# CLAUDE_MODEL=

# FEC API key for campaign finance data — https://api.open.fec.gov/developers/
# Without this, the Funding tab on rep profiles will show "not available"
# FEC_API_KEY=

# LegiScan API key for state legislation — https://legiscan.com/legiscan
# LEGISCAN_API_KEY=

# Open States API key for state legislature data — https://openstates.org/accounts/signup/
# OPENSTATES_API_KEY=

# Cloudflare Turnstile CAPTCHA
# If not set, form submissions bypass CAPTCHA verification (dev mode)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Resend email service — https://resend.com
# If not set, digest emails and notifications are skipped silently
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@mydemocracy.app

# Secret for cron job authentication (Vercel Cron pattern)
# REQUIRED in production — cron endpoints reject all requests if unset
# CRON_SECRET=

# Separate secret for unsubscribe token HMAC (falls back to CRON_SECRET)
# Recommended: use a dedicated secret so rotating CRON_SECRET doesn't invalidate tokens
# UNSUBSCRIBE_SECRET=

# Census Bureau API key — https://api.census.gov/data/key_signup.html
# If not set, Census API still works but may be rate-limited at high traffic
# CENSUS_API_KEY=

# Admin user IDs (comma-separated Supabase user UUIDs)
# Users with these IDs can access /admin routes to approve campaigns, etc.
# ADMIN_USER_IDS=

# ─── Communicating With Congress (CWC) delivery ────────────────────────────
# Real message delivery to House/Senate offices. See src/lib/cwc/README.md.
# Delivery-agent identity — CWC_DELIVERY_AGENT MUST exactly match the company
# legal name on the CWC access application (the Senate validates against it).
# CWC_DELIVERY_AGENT=My Democracy LLC
# CWC_ACK_EMAIL=
# CWC_CONTACT_NAME=
# CWC_CONTACT_EMAIL=
# CWC_CONTACT_PHONE=
# House API keys (UAT is the test env; keep both out of source control)
# CWC_HOUSE_UAT_API_KEY=
# CWC_HOUSE_API_KEY=
# Senate endpoints (issued with the Senate testing key via SOAPBox)
# SCWC_TEST_URL=
# SCWC_PRODUCTION_URL=
# QuotaGuard static-IP proxy — routes CWC calls out via our whitelisted IPs.
# Copy the connection string from the QuotaGuard dashboard.
# QUOTAGUARD_URL=
